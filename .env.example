# Cliente (público: cadastrar como Config na Vercel, não Secret)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Servidor (/api com firebase-admin) — nunca commitar
FIREBASE_SERVICE_ACCOUNT_JSON=

# Assina os links públicos de PDF (WhatsApp). 32+ caracteres aleatórios. Secret na Vercel.
PDF_LINK_SECRET=

# ATENÇÃO: nunca cadastre na Vercel estas variáveis de emulador, senão o login aceita token falso:
#   NEXT_PUBLIC_USE_EMULATOR, FIRESTORE_EMULATOR_HOST, FIREBASE_AUTH_EMULATOR_HOST
